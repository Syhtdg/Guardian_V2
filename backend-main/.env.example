# 이 파일을 .env 로 복사해서 값을 채우세요.  (cp .env.example .env)
# .env 는 git 에 올리지 않습니다.

PORT=10111
MONGO_URI=mongodb://localhost:27017/fire-detection-dev

# 로그인 토큰 서명용 비밀키. 아래 명령으로 만든 값을 붙여 넣으세요.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=2h

# YOLO 감지 프로그램이 /ai/result, /ai/error 로 보낼 때 쓰는 키 (ai/config.yaml 의 api_key 와 같아야 함)
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
AI_API_KEY=

# 프런트 주소 (여러 개면 쉼표로 구분)
CORS_ORIGIN=http://localhost:3000

# 회원가입 허용 여부 (발표 후 막고 싶으면 false)
ALLOW_SIGNUP=true

# 감지 스냅샷 이미지 저장 폴더
UPLOAD_DIR=uploads

# 인증코드 메일 발송 (Gmail 예시: 구글 계정 > 보안 > 2단계 인증 > 앱 비밀번호 발급)
# 비워 두면 메일 대신 서버 콘솔에 인증코드를 출력합니다 (개발용).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Guardian <your.account@gmail.com>

# 공공 CCTV (국가교통정보센터 ITS 오픈API) - 대시보드 지도에 CCTV 를 표시하고 실시간 영상을 봅니다.
# https://www.its.go.kr 회원가입 → 공공데이터 개방 → 오픈API 신청(CCTV 정보) → 발급된 인증키를 넣으세요.
# 비워 두면 기능이 꺼지고, "test" 를 넣으면 ITS 가 주는 시험용 목록(수도권 20곳, 영상 재생은 안 됨)이 표시됩니다.
ITS_API_KEY=
