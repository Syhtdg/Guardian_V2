# 이 파일을 .env 로 복사해서 값을 채우세요.  (cp .env.example .env)

# 백엔드 주소
VITE_API_URL=http://localhost:10111

# 카카오맵 JavaScript 키 (https://developers.kakao.com > 내 애플리케이션 > 앱 키)
# 플랫폼 > Web 에 http://localhost:3000 을 등록해야 지도가 뜹니다.
# 예전 코드에 들어 있던 키는 공개됐으니 새로 발급하거나 허용 도메인을 꼭 제한하세요.
VITE_KAKAO_MAP_KEY=

# 지도 기본 중심 좌표 (기본값: 대구가톨릭대학교 부근)
VITE_MAP_CENTER_LAT=35.9135
VITE_MAP_CENTER_LNG=128.8125
